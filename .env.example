ADMIN_EMAIL=admin@ms.senai.br
ADMIN_SENHA_PADRAO=admin123

# Proxy TLS (Caddy)
# - localhost           → certificado interno (autoassinado), para dev/teste
# - compras.example.com → Let's Encrypt automático (domínio deve apontar p/ o host)
CADDY_DOMAIN=localhost
PORTA_HTTP=80
PORTA_HTTPS=443

# SSO corporativo (Microsoft Entra ID / OIDC) — híbrido: senhas continuam
# valendo. Registre um App no Entra (App registrations → New registration):
#   - Redirect URI (Web): https://SEU-DOMINIO/api/auth/sso/callback
#   - Copie o Application (client) ID e crie um Client secret
OIDC_ENABLED=false
OIDC_ISSUER=https://login.microsoftonline.com/<TENANT-ID>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost/api/auth/sso/callback
OIDC_SPA_BASE=https://localhost
# Chave p/ assinar o `state` do OAuth (qualquer string longa e aleatória)
SECRET_KEY=
